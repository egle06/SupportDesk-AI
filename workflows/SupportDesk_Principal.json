    {
      "parameters": {
        "jsCode": "const ctx = $('Preparar_Prompt_Borrador').first().json;\nconst resp = $input.first().json;\n\n// 1. Extraer el texto, ignorando las partes de \"pensamiento\"\nconst partes = resp.content?.parts ?? [];\nconst texto = partes\n  .filter(p => p.text && p.thought !== true)\n  .map(p => p.text)\n  .join('')\n  .trim();\n\n// 2. Validaciones: un borrador defectuoso nunca debe llegar a Slack ni al cliente\nconst finish = resp.finishReason;\nif (finish !== 'STOP') {\n  throw new Error('Borrador incompleto. finishReason=' + finish);\n}\nif (texto.length < 50) {\n  throw new Error('Borrador vacío o demasiado corto');\n}\nif (!/Equipo de Soporte\\s*$/i.test(texto)) {\n  throw new Error('El borrador no termina con la firma esperada');\n}\n// Tokens y costo del borrador (se suman a los de la clasificación)\nconst cls = $('Parsear_Respuesta_IA').first().json;\nconst cfg = $('Config').first().json;\nconst u = resp.usageMetadata || resp.usage || {};\nlet tIn = Number(u.promptTokenCount ?? u.input_tokens ?? u.prompt_tokens ?? 0);\nlet tOut = Number(u.candidatesTokenCount ?? u.output_tokens ?? u.completion_tokens ?? 0);\n\nif (tIn === 0 && tOut === 0) {\n  // Estimación: ~4 caracteres por token. 900 = largo aproximado del prompt de sistema.\n  const prompt = [ctx.prioridad, ctx.resumen, ctx.asunto, ctx.cuerpo, ctx.kb_texto].join(' ');\n  tIn = Math.ceil((900 + prompt.length) / 4);\n  tOut = Math.ceil(texto.length / 4);\n}\n\nconst costoBorrador = (tIn * Number(cfg.precio_in_por_millon) + tOut * Number(cfg.precio_out_por_millon)) / 1e6;\nreturn [{\n  json: {\n    ticket_record_id: ctx.ticket_record_id,\n    borrador: texto.slice(0, 2000),\n    hay_kb: ctx.hay_kb,\n    prioridad: ctx.prioridad,\n    categoria: ctx.categoria,\n    tokens_in_total: Number(cls.tokens_in) + tIn,\n    tokens_out_total: Number(cls.tokens_out) + tOut,\n    costo_total: Number((Number(cls.costo_usd) + costoBorrador).toFixed(6))\n  }\n}];"
      },
